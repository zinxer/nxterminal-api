# Server
PORT=3000
HOST=https://terminal.example.com          # production CORS origin
DEV_HOST=http://localhost:3000             # development CORS origin
NODE_ENV=development

# Database (MySQL)
DB_HOST=127.0.0.1
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=nxterminal

# Auth secrets: generate long random values, e.g. `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret

# Shared key required in the x-broker-api-key header for /terminal/api/broker/*
BROKER_API_KEY=change-me-broker-api-key
